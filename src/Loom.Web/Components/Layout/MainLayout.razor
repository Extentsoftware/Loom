@*
    Top-level layout for authenticated pages. The chrome echoes the
    Operating Picture mockup at low fidelity — brand on left, project
    pill, search placeholder, nav links, user avatar — without the
    polished editorial aesthetic. Visual direction comes in a later slice.
*@

@inherits LayoutComponentBase

<div class="app">
    <nav class="app-nav">
        <span class="brand">Loom</span>
        <span class="proj-pill"><span class="dot"></span>retail-web · main</span>
        <input class="nav-search" type="text" placeholder="search nodes, fragments, runs…" disabled />
        <div class="nav-links">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" ActiveClass="nav-link-active">Operating picture</NavLink>
            <NavLink href="/fragments" class="nav-link" ActiveClass="nav-link-active">Library</NavLink>
            <NavLink href="/workflows" class="nav-link" ActiveClass="nav-link-active">Workflows</NavLink>
            <NavLink href="/activity" class="nav-link" ActiveClass="nav-link-active">Activity</NavLink>
        </div>
        <UserMenu />
    </nav>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
