@*
    Options dropdown in the top nav. Groups settings-style entries
    (subscriptions, general settings, future preferences) under one
    button so the nav doesn't sprawl. Click outside or pick an item to
    dismiss.
*@

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="options-menu @(_open ? "options-menu-open" : "")" @onclick:stopPropagation="true">
    <button type="button" class="nav-link options-trigger" @onclick="Toggle" aria-haspopup="true" aria-expanded="@_open">
        Options ▾
    </button>
    @if (_open)
    {
        <div class="options-panel" @onclick="Close">
            <a href="/settings/subscriptions" class="options-item">
                <span class="options-icon">🔔</span>
                <span>
                    <div class="options-title">Subscriptions</div>
                    <div class="options-sub">Notification scopes &amp; channels</div>
                </span>
            </a>
            <a href="/notifications" class="options-item">
                <span class="options-icon">📥</span>
                <span>
                    <div class="options-title">Notification feed</div>
                    <div class="options-sub">Recent alerts in one place</div>
                </span>
            </a>
            <a href="/settings" class="options-item">
                <span class="options-icon">⚙</span>
                <span>
                    <div class="options-title">Settings</div>
                    <div class="options-sub">App preferences</div>
                </span>
            </a>
        </div>
    }
</div>

@code {
    private bool _open;

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;
}
