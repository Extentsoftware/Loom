@page "/notifications"
@*
    Full notification feed. Lists recent notifications with per-row
    mark-read / open / delete affordances and bulk mark-all-read /
    clear-all controls. Each mutation goes through its own DI scope so
    the operation can't race with the page's own load against the
    circuit-shared DbContext.
*@

@using Loom.Application.Notifications
@using Loom.Domain.Notifications
@using Loom.Web.Services
@inject IServiceScopeFactory ScopeFactory
@inject INotificationFeed Feed
@inject CurrentUserAccessor CurrentUser
@inject NavigationManager Nav
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<h1 class="page-title">Notifications</h1>

<section class="ws-section">
    <div class="ws-section-header">
        <h2>Recent</h2>
        <div style="display:flex; gap:.5rem;">
            <button class="btn-secondary" @onclick="MarkAllReadAsync" disabled="@(_unread == 0)">Mark all read (@_unread)</button>
            <button class="btn-secondary" @onclick="ClearAllAsync" disabled="@(_items.Count == 0)">Clear all</button>
        </div>
    </div>

    @if (_items.Count == 0)
    {
        <p class="muted">Nothing yet. Subscriptions live at <a href="/settings/subscriptions">Settings</a>.</p>
    }
    else
    {
        <ul class="notif-list">
            @foreach (var n in _items)
            {
                <li class="notif-item @(n.ReadAt is null ? "notif-unread" : "")">
                    <div class="notif-title">@n.Title</div>
                    <div class="notif-body">@n.Body</div>
                    <div class="notif-meta">
                        <span>@n.CreatedAt.ToLocalTime().ToString("g")</span>
                        @if (!string.IsNullOrWhiteSpace(n.DeepLink))
                        {
                            <button class="btn-link" @onclick="() => OpenAsync(n)">Open</button>
                        }
                        @if (n.ReadAt is null)
                        {
                            <button class="btn-link" @onclick="() => MarkReadAsync(n)">Mark read</button>
                        }
                        <button class="btn-link" @onclick="() => DeleteAsync(n)" title="Delete this notification">Delete</button>
                    </div>
                </li>
            }
        </ul>
    }
</section>

@code {
    private readonly List<Notification> _items = [];
    private int _unread;
    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        _userId = CurrentUser.GetUserId();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items.Clear();
        _items.AddRange(await Feed.ListRecentAsync(_userId, take: 100));
        _unread = await Feed.UnreadCountAsync(_userId);
        StateHasChanged();
    }

    // Each mutation runs in its own scope so it doesn't race the
    // circuit-shared DbContext (mark-as-read used to silently lose to
    // a concurrent LoadAsync; deletion has the same risk).
    private async Task RunInScope(Func<INotificationFeed, Task> op)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var feed = scope.ServiceProvider.GetRequiredService<INotificationFeed>();
        await op(feed);
    }

    private async Task MarkAllReadAsync()
    {
        await RunInScope(f => f.MarkAllReadAsync(_userId));
        await LoadAsync();
    }

    private async Task ClearAllAsync()
    {
        await RunInScope(f => f.DeleteAllAsync(_userId));
        await LoadAsync();
    }

    private async Task MarkReadAsync(Notification n)
    {
        await RunInScope(f => f.MarkReadAsync(n.Id, _userId));
        await LoadAsync();
    }

    private async Task DeleteAsync(Notification n)
    {
        await RunInScope(f => f.DeleteAsync(n.Id, _userId));
        await LoadAsync();
    }

    private async Task OpenAsync(Notification n)
    {
        // Mark-read must commit before the navigation kicks off the next
        // request; the in-scope await guarantees that.
        await RunInScope(f => f.MarkReadAsync(n.Id, _userId));
        Nav.NavigateTo(n.DeepLink!);
    }
}
