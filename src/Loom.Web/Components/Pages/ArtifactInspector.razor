@*
    Artifact Inspector. Phase-4 read-mostly UI: surfaces the version chain
    (with author + reason + timestamps), the current preview pointer, the
    lock state (with acquire/release controls for the holder), and a list
    of annotations with their polymorphic target locator. Adding an
    annotation is a one-textbox form; richer locators (Figma frames, code
    line ranges) ship when the source-system plugins land in Phase 4b.
*@

@page "/artifacts/{ArtifactId:guid}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IArtifactRepository ArtifactRepo
@inject IArtifactService Artifacts
@inject Loom.Web.Services.CurrentUserAccessor CurrentUser
@inject NavigationManager Nav

<PageTitle>@(_artifact?.Title ?? "Artifact") · Loom</PageTitle>

@if (!_loaded)
{
    <p class="loading">Loading…</p>
}
else if (_artifact is null)
{
    <section class="empty-state">
        <h2>Artifact not found.</h2>
        <p><a href="/">Back to Operating Picture</a></p>
    </section>
}
else
{
    <header class="page-head">
        <p class="page-meta">
            <a href="@($"/n/{_artifact.NodeId.Value:D}")">← Target node</a>
        </p>
        <h1 class="page-title">@_artifact.Title</h1>
        <p class="page-meta">
            Kind: <strong>@_artifact.Kind</strong>
            · Canonical: <strong>@_artifact.Canonical.Store</strong>
            @if (_artifact.Canonical.Store != Loom.Domain.Artifacts.CanonicalStore.HubNative)
            {
                <span> / <code>@TruncateForHeader(_artifact.Canonical.ExternalId)</code></span>
                @if (!string.IsNullOrWhiteSpace(_artifact.Canonical.Url))
                {
                    <span> · <a href="@_artifact.Canonical.Url" target="_blank" rel="noopener">open in @_artifact.Canonical.Store</a></span>
                }
            }
            @if (_artifact.LastSyncedAt is not null)
            {
                <span> · Last synced @_artifact.LastSyncedAt.Value.ToString("u")</span>
            }
        </p>
    </header>

    @* Per-kind body renderer. Only fires for hub-native artifacts (where
       the canonical pointer's ExternalId actually carries the body). For
       external stores the link in the header is the entry point. *@
    @if (_artifact.Canonical.Store == Loom.Domain.Artifacts.CanonicalStore.HubNative
         && !string.IsNullOrWhiteSpace(_artifact.Canonical.ExternalId))
    {
        <section class="ws-section">
            <h2>Content</h2>
            @switch (_artifact.Kind)
            {
                case Loom.Domain.Artifacts.ArtifactKind.Wireframe:
                    @RenderWireframe(_artifact.Canonical.ExternalId)
                    break;
                case Loom.Domain.Artifacts.ArtifactKind.Criteria:
                    @RenderCriteria(_artifact.Canonical.ExternalId)
                    break;
                case Loom.Domain.Artifacts.ArtifactKind.Risks:
                    @RenderRisks(_artifact.Canonical.ExternalId)
                    break;
                case Loom.Domain.Artifacts.ArtifactKind.Doc:
                    @RenderDoc(_artifact.Title, _artifact.Canonical.ExternalId)
                    break;
                case Loom.Domain.Artifacts.ArtifactKind.TestPlan:
                    @RenderTestPlan(_artifact.Canonical.ExternalId)
                    break;
                default:
                    @RenderFallback(_artifact.Canonical.ExternalId, _artifact.Kind)
                    break;
            }
        </section>
    }

    <section class="ws-section">
        <h2>Lock</h2>
        @if (_artifact.Lock is null || !_artifact.Lock.IsActiveAt(DateTimeOffset.UtcNow))
        {
            <p class="muted">Unlocked.</p>
            <button class="btn-primary" @onclick="AcquireAsync" disabled="@_busy">
                @(_busy ? "Acquiring…" : "Acquire 15-minute lock")
            </button>
        }
        else
        {
            var heldByMe = _artifact.Lock.HolderUserId == CurrentUser.GetUserId();
            <p>
                Locked until <strong>@_artifact.Lock.ExpiresAt.ToString("u")</strong>
                @if (heldByMe)
                {
                    <span> (you)</span>
                }
                else
                {
                    <span> by another user (<code>@_artifact.Lock.HolderUserId.ToString("N").Substring(0, 8)</code>)</span>
                }
            </p>
            @if (heldByMe)
            {
                <button class="btn-primary" @onclick="ReleaseAsync" disabled="@_busy">
                    @(_busy ? "Releasing…" : "Release lock")
                </button>
            }
        }
        @if (_lockError is not null)
        {
            <p class="error">@_lockError</p>
        }
    </section>

    <section class="ws-section">
        <h2>Version chain (@_artifact.Versions.Count)</h2>
        @if (_artifact.Versions.Count == 0)
        {
            <p class="muted">No versions published yet.</p>
        }
        else
        {
            <table class="run-table">
                <thead><tr><th>v</th><th>Author</th><th>Created</th><th>Reason</th><th>Content</th><th>Preview</th></tr></thead>
                <tbody>
                    @foreach (var v in _artifact.Versions.OrderByDescending(x => x.VersionNumber))
                    {
                        <tr>
                            <td>@v.VersionNumber</td>
                            <td>@v.Author.Kind · <code>@v.Author.Id.ToString("N").Substring(0, 8)</code></td>
                            <td>@v.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@v.Reason</td>
                            <td>
                                <a href="@v.Content.Uri" target="_blank" rel="noopener">@v.Content.ContentType</a>
                                @if (v.Content.SizeBytes is long b)
                                {
                                    <span class="muted"> · @FormatBytes(b)</span>
                                }
                            </td>
                            <td>
                                @if (v.Preview is not null)
                                {
                                    <a href="@v.Preview.Uri" target="_blank" rel="noopener">preview</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="ws-section">
        <h2>Annotations (@_annotations.Count)</h2>

        <EditForm Model="_newAnnotation" OnValidSubmit="AddAnnotationAsync">
            <div class="form-row">
                <label>Body</label>
                <textarea rows="3" @bind="_newAnnotation.Body"></textarea>
            </div>
            <div class="form-row">
                <label>Tags (comma-separated)</label>
                <input @bind="_newAnnotation.TagsCsv" />
            </div>
            <div class="form-row">
                <label>Kind</label>
                <select @bind="_newAnnotation.Kind">
                    <option value="@AnnotationKind.Comment">Comment</option>
                    <option value="@AnnotationKind.Critique">Critique</option>
                    <option value="@AnnotationKind.Approval">Approval</option>
                    <option value="@AnnotationKind.Concern">Concern</option>
                </select>
            </div>
            <button type="submit" class="btn-primary" disabled="@_busy">
                @(_busy ? "Adding…" : "Add annotation")
            </button>
            @if (_annotationError is not null)
            {
                <p class="error">@_annotationError</p>
            }
        </EditForm>

        @if (_annotations.Count == 0)
        {
            <p class="muted">No annotations yet.</p>
        }
        else
        {
            <ul class="annotation-list">
                @foreach (var a in _annotations.OrderByDescending(x => x.CreatedAt))
                {
                    <li class="annotation">
                        <p class="muted">
                            @a.Kind
                            · @a.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            @if (a.UserId is Guid uid)
                            {
                                <span> · <code>@uid.ToString("N").Substring(0, 8)</code></span>
                            }
                            @if (a.Target is not null)
                            {
                                <span> · target=<code>@a.Target.Kind</code></span>
                            }
                        </p>
                        <p>@a.Body</p>
                        @if (a.Tags.Count > 0)
                        {
                            <p class="tags">
                                @foreach (var t in a.Tags)
                                {
                                    <span class="tag">@t</span>
                                }
                            </p>
                        }
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    private static string TruncateForHeader(string s) =>
        s.Length <= 80 ? s : s[..77] + "…";

    private RenderFragment RenderWireframe(string body) => builder =>
    {
        var (description, html) = TryParseWireframe(body);
        if (description is not null)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "muted");
            builder.AddContent(2, description);
            builder.CloseElement();
        }
        if (!string.IsNullOrWhiteSpace(html))
        {
            // Sandboxed iframe with srcdoc — isolated origin, no scripts,
            // no top-nav. Width/height are best-effort; future iteration
            // can persist them on the artifact.
            builder.OpenElement(10, "iframe");
            builder.AddAttribute(11, "srcdoc", html);
            builder.AddAttribute(12, "sandbox", "");
            builder.AddAttribute(13, "style", "width:100%; min-height:600px; border:1px solid var(--border, #333); background:#fff;");
            builder.AddAttribute(14, "title", "Wireframe preview");
            builder.CloseElement();
        }
        else if (description is null)
        {
            builder.AddContent(20, RenderFallback(body, Loom.Domain.Artifacts.ArtifactKind.Wireframe));
        }
    };

    private RenderFragment RenderCriteria(string body) => builder =>
    {
        var items = TryParseCriteria(body);
        if (items is null || items.Count == 0)
        {
            builder.AddContent(0, RenderFallback(body, Loom.Domain.Artifacts.ArtifactKind.Criteria));
            return;
        }
        builder.AddContent(10, RenderCriteriaList(items));
    };

    private RenderFragment RenderCriteriaList(IReadOnlyList<CriteriaItem> items) => builder =>
    {
        builder.OpenElement(0, "ul");
        builder.AddAttribute(1, "class", "criteria-list");
        var seq = 2;
        foreach (var c in items)
        {
            builder.OpenElement(seq++, "li");
            builder.OpenElement(seq++, "div");
            builder.AddContent(seq++, c.Statement);
            if (c.Measurable)
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "badge");
                builder.AddAttribute(seq++, "style", "margin-left:.5rem;");
                builder.AddContent(seq++, "measurable");
                builder.CloseElement();
            }
            builder.CloseElement();
            if (!string.IsNullOrWhiteSpace(c.MetricHint))
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "muted");
                builder.AddContent(seq++, c.MetricHint);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment RenderRisks(string body) => builder =>
    {
        var items = TryParseRisks(body);
        if (items is null || items.Count == 0)
        {
            builder.AddContent(0, RenderFallback(body, Loom.Domain.Artifacts.ArtifactKind.Risks));
            return;
        }
        builder.AddContent(10, RenderRisksTable(items));
    };

    private RenderFragment RenderRisksTable(IReadOnlyList<RiskItem> items) => builder =>
    {
        builder.OpenElement(0, "table");
        builder.AddAttribute(1, "class", "ws-table");
        builder.OpenElement(2, "thead");
        builder.OpenElement(3, "tr");
        foreach (var h in new[] { "Risk", "Likelihood", "Impact", "Mitigation" })
        {
            builder.OpenElement(4, "th");
            builder.AddContent(5, h);
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(10, "tbody");
        var seq = 11;
        foreach (var r in items)
        {
            builder.OpenElement(seq++, "tr");
            foreach (var v in new[] { r.Risk, r.Likelihood, r.Impact, r.Mitigation })
            {
                builder.OpenElement(seq++, "td");
                builder.AddContent(seq++, v);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
    };

    private static (string? Description, string? Html) TryParseWireframe(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            var root = doc.RootElement;
            string? d = root.TryGetProperty("description", out var dp) && dp.ValueKind == System.Text.Json.JsonValueKind.String ? dp.GetString() : null;
            string? h = root.TryGetProperty("html", out var hp) && hp.ValueKind == System.Text.Json.JsonValueKind.String ? hp.GetString() : null;
            return (d, h);
        }
        catch (System.Text.Json.JsonException)
        {
            return (null, null);
        }
    }

    private sealed record CriteriaItem(string Statement, string? MetricHint, bool Measurable);
    private static List<CriteriaItem>? TryParseCriteria(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            var root = doc.RootElement;
            // Tolerate either a top-level array or a wrapper {criteria: [...]}.
            var arr = root.ValueKind == System.Text.Json.JsonValueKind.Array
                ? root
                : root.TryGetProperty("criteria", out var c) ? c : default;
            if (arr.ValueKind != System.Text.Json.JsonValueKind.Array) return null;
            var list = new List<CriteriaItem>();
            foreach (var el in arr.EnumerateArray())
            {
                var s = el.TryGetProperty("statement", out var sp) && sp.ValueKind == System.Text.Json.JsonValueKind.String ? sp.GetString() : null;
                if (string.IsNullOrWhiteSpace(s)) continue;
                var m = el.TryGetProperty("metric_hint", out var mp) && mp.ValueKind == System.Text.Json.JsonValueKind.String ? mp.GetString() : null;
                var meas = el.TryGetProperty("measurable", out var mep) && mep.ValueKind == System.Text.Json.JsonValueKind.True;
                list.Add(new CriteriaItem(s!, m, meas));
            }
            return list;
        }
        catch (System.Text.Json.JsonException) { return null; }
    }

    private sealed record RiskItem(string Risk, string Likelihood, string Impact, string Mitigation);
    private static List<RiskItem>? TryParseRisks(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            var root = doc.RootElement;
            var arr = root.ValueKind == System.Text.Json.JsonValueKind.Array
                ? root
                : root.TryGetProperty("risks", out var r) ? r : default;
            if (arr.ValueKind != System.Text.Json.JsonValueKind.Array) return null;
            var list = new List<RiskItem>();
            foreach (var el in arr.EnumerateArray())
            {
                string Get(string name) =>
                    el.TryGetProperty(name, out var p) && p.ValueKind == System.Text.Json.JsonValueKind.String
                        ? (p.GetString() ?? string.Empty) : string.Empty;
                var risk = Get("risk");
                if (string.IsNullOrWhiteSpace(risk)) continue;
                list.Add(new RiskItem(risk, Get("likelihood"), Get("impact"), Get("mitigation")));
            }
            return list;
        }
        catch (System.Text.Json.JsonException) { return null; }
    }

    private sealed record DiscoveryOutcomeView(string Statement, string? MetricHint, bool Measurable);
    private sealed record DiscoveryHypothesisView(string If, string Then, string Because);
    private sealed record DiscoveryStakeholderView(string Name, string Role, string? Interest);
    private sealed record DiscoveryView(
        string? Title, string? Intent,
        IReadOnlyList<DiscoveryOutcomeView> Outcomes,
        IReadOnlyList<DiscoveryHypothesisView> Hypotheses,
        IReadOnlyList<string> OpenQuestions,
        IReadOnlyList<DiscoveryStakeholderView> Stakeholders);

    private static DiscoveryView? TryParseDiscovery(System.Text.Json.JsonElement root)
    {
        if (root.ValueKind != System.Text.Json.JsonValueKind.Object) return null;

        bool HasArray(string name) =>
            root.TryGetProperty(name, out var p) && p.ValueKind == System.Text.Json.JsonValueKind.Array;
        var arrayHits = (HasArray("outcomes") ? 1 : 0)
                       + (HasArray("hypotheses") ? 1 : 0)
                       + (HasArray("open_questions") ? 1 : 0)
                       + (HasArray("stakeholders") ? 1 : 0);
        if (arrayHits < 2) return null;

        var title = root.TryGetProperty("title", out var tp) && tp.ValueKind == System.Text.Json.JsonValueKind.String
            ? tp.GetString() : null;
        var intent = root.TryGetProperty("intent", out var ip) && ip.ValueKind == System.Text.Json.JsonValueKind.String
            ? ip.GetString() : null;

        var outcomes = new List<DiscoveryOutcomeView>();
        if (root.TryGetProperty("outcomes", out var op) && op.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            foreach (var el in op.EnumerateArray())
            {
                if (el.ValueKind != System.Text.Json.JsonValueKind.Object) continue;
                var s = GetString(el, "statement");
                if (string.IsNullOrWhiteSpace(s)) continue;
                var hint = GetString(el, "metric_hint");
                var meas = el.TryGetProperty("measurable", out var mep) && mep.ValueKind == System.Text.Json.JsonValueKind.True;
                outcomes.Add(new DiscoveryOutcomeView(s, string.IsNullOrWhiteSpace(hint) ? null : hint, meas));
            }
        }

        var hypotheses = new List<DiscoveryHypothesisView>();
        if (root.TryGetProperty("hypotheses", out var hp) && hp.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            foreach (var el in hp.EnumerateArray())
            {
                if (el.ValueKind != System.Text.Json.JsonValueKind.Object) continue;
                var ifv = GetString(el, "if");
                var thenv = GetString(el, "then");
                var bec = GetString(el, "because");
                if (string.IsNullOrWhiteSpace(ifv) && string.IsNullOrWhiteSpace(thenv)) continue;
                hypotheses.Add(new DiscoveryHypothesisView(ifv, thenv, bec));
            }
        }

        var openQuestions = new List<string>();
        if (root.TryGetProperty("open_questions", out var qp) && qp.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            foreach (var el in qp.EnumerateArray())
            {
                if (el.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var s = el.GetString();
                    if (!string.IsNullOrWhiteSpace(s)) openQuestions.Add(s!);
                }
            }
        }

        var stakeholders = new List<DiscoveryStakeholderView>();
        if (root.TryGetProperty("stakeholders", out var sp) && sp.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            foreach (var el in sp.EnumerateArray())
            {
                if (el.ValueKind != System.Text.Json.JsonValueKind.Object) continue;
                var name = GetString(el, "name");
                if (string.IsNullOrWhiteSpace(name)) continue;
                var role = GetString(el, "role");
                var interest = GetString(el, "interest");
                stakeholders.Add(new DiscoveryStakeholderView(name, role, string.IsNullOrWhiteSpace(interest) ? null : interest));
            }
        }

        return new DiscoveryView(title, intent, outcomes, hypotheses, openQuestions, stakeholders);
    }

    private sealed record DecompositionChildView(string Slug, string Title, string Type, string? Intent, string? ParentSlug);
    private sealed record DecompositionView(IReadOnlyList<DecompositionChildView> Children);

    private static DecompositionView? TryParseDecomposition(System.Text.Json.JsonElement root)
    {
        if (root.ValueKind != System.Text.Json.JsonValueKind.Object) return null;
        if (!root.TryGetProperty("children", out var arr) || arr.ValueKind != System.Text.Json.JsonValueKind.Array) return null;
        var list = new List<DecompositionChildView>();
        foreach (var el in arr.EnumerateArray())
        {
            if (el.ValueKind != System.Text.Json.JsonValueKind.Object) continue;
            var slug = GetString(el, "slug");
            var title = GetString(el, "title");
            if (string.IsNullOrWhiteSpace(slug) || string.IsNullOrWhiteSpace(title)) continue;
            var type = GetString(el, "type");
            var intent = GetString(el, "intent");
            var parent = GetString(el, "parentSlug");
            list.Add(new DecompositionChildView(
                slug, title, type,
                string.IsNullOrWhiteSpace(intent) ? null : intent,
                string.IsNullOrWhiteSpace(parent) ? null : parent));
        }
        if (list.Count == 0) return null;
        return new DecompositionView(list);
    }

    // -------- Doc renderer (slice design or implementation plan) --------
    // Detects which schema by inspecting the JSON shape and dispatches to
    // a specific renderer. Falls through to a <pre> if neither matches.
    private RenderFragment RenderDoc(string title, string body) => builder =>
    {
        System.Text.Json.JsonDocument? doc = null;
        try { doc = System.Text.Json.JsonDocument.Parse(body); } catch (System.Text.Json.JsonException) { }
        if (doc is not null)
        {
            using (doc)
            {
                var root = doc.RootElement;
                if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    if (root.TryGetProperty("data_model", out _) || root.TryGetProperty("endpoints", out _))
                    {
                        builder.AddContent(0, RenderSliceDesign(root));
                        return;
                    }
                    if (root.TryGetProperty("steps", out _))
                    {
                        builder.AddContent(0, RenderImplementationPlan(root));
                        return;
                    }
                }
            }
        }
        builder.AddContent(10, RenderFallback(body, Loom.Domain.Artifacts.ArtifactKind.Doc));
    };

    private static string GetString(System.Text.Json.JsonElement el, string name) =>
        el.TryGetProperty(name, out var p) && p.ValueKind == System.Text.Json.JsonValueKind.String
            ? (p.GetString() ?? string.Empty) : string.Empty;

    private RenderFragment RenderSliceDesign(System.Text.Json.JsonElement root) => builder =>
    {
        var seq = 0;
        var summary = GetString(root, "summary");
        if (!string.IsNullOrWhiteSpace(summary))
        {
            builder.OpenElement(seq++, "p"); builder.AddContent(seq++, summary); builder.CloseElement();
        }

        if (root.TryGetProperty("data_model", out var dm) && dm.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            builder.OpenElement(seq++, "h3"); builder.AddContent(seq++, "Data model"); builder.CloseElement();
            foreach (var entity in dm.EnumerateArray())
            {
                builder.OpenElement(seq++, "h4");
                builder.AddContent(seq++, GetString(entity, "entity"));
                builder.CloseElement();
                var rationale = GetString(entity, "rationale");
                if (!string.IsNullOrWhiteSpace(rationale))
                {
                    builder.OpenElement(seq++, "p"); builder.AddAttribute(seq++, "class", "muted");
                    builder.AddContent(seq++, rationale); builder.CloseElement();
                }
                if (entity.TryGetProperty("fields", out var fields) && fields.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    builder.OpenElement(seq++, "table"); builder.AddAttribute(seq++, "class", "ws-table");
                    builder.OpenElement(seq++, "thead"); builder.OpenElement(seq++, "tr");
                    foreach (var h in new[] { "Name", "Type", "Notes" })
                    { builder.OpenElement(seq++, "th"); builder.AddContent(seq++, h); builder.CloseElement(); }
                    builder.CloseElement(); builder.CloseElement();
                    builder.OpenElement(seq++, "tbody");
                    foreach (var f in fields.EnumerateArray())
                    {
                        builder.OpenElement(seq++, "tr");
                        foreach (var v in new[] { GetString(f, "name"), GetString(f, "type"), GetString(f, "notes") })
                        { builder.OpenElement(seq++, "td"); builder.AddContent(seq++, v); builder.CloseElement(); }
                        builder.CloseElement();
                    }
                    builder.CloseElement(); builder.CloseElement();
                }
            }
        }

        if (root.TryGetProperty("endpoints", out var eps) && eps.ValueKind == System.Text.Json.JsonValueKind.Array && eps.GetArrayLength() > 0)
        {
            builder.OpenElement(seq++, "h3"); builder.AddContent(seq++, "Endpoints"); builder.CloseElement();
            builder.OpenElement(seq++, "table"); builder.AddAttribute(seq++, "class", "ws-table");
            builder.OpenElement(seq++, "thead"); builder.OpenElement(seq++, "tr");
            foreach (var h in new[] { "Verb", "Route", "Purpose", "Request", "Response" })
            { builder.OpenElement(seq++, "th"); builder.AddContent(seq++, h); builder.CloseElement(); }
            builder.CloseElement(); builder.CloseElement();
            builder.OpenElement(seq++, "tbody");
            foreach (var e in eps.EnumerateArray())
            {
                builder.OpenElement(seq++, "tr");
                foreach (var v in new[] { GetString(e, "verb"), GetString(e, "route"), GetString(e, "purpose"), GetString(e, "request"), GetString(e, "response") })
                { builder.OpenElement(seq++, "td"); builder.AddContent(seq++, v); builder.CloseElement(); }
                builder.CloseElement();
            }
            builder.CloseElement(); builder.CloseElement();
        }

        if (root.TryGetProperty("handlers", out var hs) && hs.ValueKind == System.Text.Json.JsonValueKind.Array && hs.GetArrayLength() > 0)
        {
            builder.OpenElement(seq++, "h3"); builder.AddContent(seq++, "Handlers"); builder.CloseElement();
            builder.OpenElement(seq++, "ul");
            foreach (var h in hs.EnumerateArray())
            {
                builder.OpenElement(seq++, "li");
                builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, GetString(h, "name")); builder.CloseElement();
                builder.AddContent(seq++, " — " + GetString(h, "purpose"));
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        RenderQuestionList(builder, ref seq, root, "open_questions", "Open questions");
    };

    private RenderFragment RenderImplementationPlan(System.Text.Json.JsonElement root) => builder =>
    {
        var seq = 0;
        var summary = GetString(root, "summary");
        if (!string.IsNullOrWhiteSpace(summary))
        {
            builder.OpenElement(seq++, "p"); builder.AddContent(seq++, summary); builder.CloseElement();
        }

        if (root.TryGetProperty("steps", out var steps) && steps.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            builder.OpenElement(seq++, "h3"); builder.AddContent(seq++, "Steps"); builder.CloseElement();
            builder.OpenElement(seq++, "ol");
            foreach (var s in steps.EnumerateArray())
            {
                builder.OpenElement(seq++, "li");
                builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, GetString(s, "title")); builder.CloseElement();
                var rationale = GetString(s, "rationale");
                if (!string.IsNullOrWhiteSpace(rationale))
                {
                    builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "muted");
                    builder.AddContent(seq++, rationale); builder.CloseElement();
                }
                if (s.TryGetProperty("files", out var files) && files.ValueKind == System.Text.Json.JsonValueKind.Array && files.GetArrayLength() > 0)
                {
                    builder.OpenElement(seq++, "div");
                    builder.AddContent(seq++, "Files: ");
                    var first = true;
                    foreach (var f in files.EnumerateArray())
                    {
                        if (!first) builder.AddContent(seq++, ", ");
                        first = false;
                        builder.OpenElement(seq++, "code"); builder.AddContent(seq++, f.GetString() ?? string.Empty); builder.CloseElement();
                    }
                    builder.CloseElement();
                }
                var verify = GetString(s, "verification");
                if (!string.IsNullOrWhiteSpace(verify))
                {
                    builder.OpenElement(seq++, "div"); builder.AddContent(seq++, "Verify: " + verify); builder.CloseElement();
                }
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        RenderQuestionList(builder, ref seq, root, "risks", "Technical risks");
        RenderQuestionList(builder, ref seq, root, "open_questions", "Open questions");
    };

    private RenderFragment RenderTestPlan(string body) => builder =>
    {
        System.Text.Json.JsonDocument? doc = null;
        try { doc = System.Text.Json.JsonDocument.Parse(body); } catch (System.Text.Json.JsonException) { }
        if (doc is null)
        {
            builder.AddContent(0, RenderFallback(body, Loom.Domain.Artifacts.ArtifactKind.TestPlan));
            return;
        }
        using (doc)
        {
            var root = doc.RootElement;
            var seq = 0;
            var summary = GetString(root, "summary");
            if (!string.IsNullOrWhiteSpace(summary))
            {
                builder.OpenElement(seq++, "p"); builder.AddContent(seq++, summary); builder.CloseElement();
            }
            if (root.TryGetProperty("cases", out var cases) && cases.ValueKind == System.Text.Json.JsonValueKind.Array && cases.GetArrayLength() > 0)
            {
                builder.OpenElement(seq++, "table"); builder.AddAttribute(seq++, "class", "ws-table");
                builder.OpenElement(seq++, "thead"); builder.OpenElement(seq++, "tr");
                foreach (var h in new[] { "ID", "Title", "Level", "Given", "When", "Then" })
                { builder.OpenElement(seq++, "th"); builder.AddContent(seq++, h); builder.CloseElement(); }
                builder.CloseElement(); builder.CloseElement();
                builder.OpenElement(seq++, "tbody");
                foreach (var c in cases.EnumerateArray())
                {
                    builder.OpenElement(seq++, "tr");
                    foreach (var v in new[] { GetString(c, "id"), GetString(c, "title"), GetString(c, "level"),
                                              GetString(c, "given"), GetString(c, "when"), GetString(c, "then") })
                    { builder.OpenElement(seq++, "td"); builder.AddContent(seq++, v); builder.CloseElement(); }
                    builder.CloseElement();
                }
                builder.CloseElement(); builder.CloseElement();
            }
            RenderQuestionList(builder, ref seq, root, "gaps", "Coverage gaps");
        }
    };

    private static void RenderQuestionList(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ref int seq,
        System.Text.Json.JsonElement root, string property, string heading)
    {
        if (!root.TryGetProperty(property, out var arr) || arr.ValueKind != System.Text.Json.JsonValueKind.Array || arr.GetArrayLength() == 0)
        {
            return;
        }
        builder.OpenElement(seq++, "h3"); builder.AddContent(seq++, heading); builder.CloseElement();
        builder.OpenElement(seq++, "ul");
        foreach (var q in arr.EnumerateArray())
        {
            if (q.ValueKind != System.Text.Json.JsonValueKind.String) continue;
            builder.OpenElement(seq++, "li"); builder.AddContent(seq++, q.GetString()); builder.CloseElement();
        }
        builder.CloseElement();
    }

