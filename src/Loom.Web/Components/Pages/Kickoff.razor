@*
    Kickoff page — the Phase-1 demo entry point. Paste a transcript, hit
    Analyse, and the scope classifier suggests whether this is a single-
    feature or multi-feature kickoff. The PO confirms (or overrides),
    then the workflow engine pumps the transcript through:
       normalize (in-proc) → discovery (Foundry) → human gate
    Once the engine pauses at the discovery gate the page redirects to
    /runs/{runId}/gate where the PO reviews and accepts the discovery.

    A default project is auto-created if the deployment is empty. Single-
    project deployments (the Phase-1 default) just use the first one.
*@

@page "/kickoff"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IFeatureService Features
@inject IProjectRepository Projects
@inject IWorkflowRepository Workflows
@inject IWorkflowEngine Engine
@inject Loom.Application.Workflows.Kickoff.IScopeClassifier ScopeClassifier
@inject Loom.Web.Services.CurrentUserAccessor CurrentUser
@inject NavigationManager Nav

<PageTitle>Kickoff · Loom</PageTitle>

<header class="page-head">
    <p class="page-meta"><a href="/">← Operating Picture</a></p>
    <h1 class="page-title">Kickoff a <em>feature</em></h1>
    <p class="page-meta">Paste a discovery transcript. Loom will extract a Discovery Object for your review.</p>
</header>

<section class="ws-section">
    <EditForm Model="_form" OnValidSubmit="AnalyseAsync">
        <div class="form-row">
            <label>Project</label>
            @if (_loadedProjects && _projects.Count > 0)
            {
                <select @bind="_form.ProjectId">
                    @foreach (var p in _projects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            }
            else
            {
                <p class="muted">A default project will be created on first kickoff.</p>
            }
        </div>
        <div class="form-row">
            <label>Working title</label>
            <input @bind="_form.Title" placeholder="A short label for this feature or initiative; the agent may suggest a better one" />
        </div>
        <div class="form-row">
            <label>Transcript</label>
            <textarea rows="20" @bind="_form.Transcript" placeholder="Anna: We need express checkout..." required></textarea>
        </div>
        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }
        @if (_classification is null)
        {
            <button type="submit" class="btn-primary" disabled="@_busy">
                @(_busy ? "Analysing…" : "Analyse transcript")
            </button>
        }
    </EditForm>

    @if (_classification is { } c)
    {
        <div class="ws-section" style="margin-top:1rem; padding:1rem; border:1px solid var(--border-2); border-radius:6px;">
            <p style="margin:0 0 .5rem 0;">
                <strong>Scope auto-detect:</strong>
                @c.Reason
                @if (c.Confidence > 0)
                {
                    <span class="muted"> (confidence @($"{c.Confidence:P0}"))</span>
                }
            </p>
            @if (c.Mode == Loom.Application.Workflows.Kickoff.KickoffScope.Multi && c.SuggestedTitles.Count > 0)
            {
                <p class="muted" style="margin:0 0 .5rem 0;">
                    Detected features: @string.Join(", ", c.SuggestedTitles)
                </p>
            }
            <p style="margin:0 0 .75rem 0;">Run as:</p>
            <button type="button" class="@(c.Mode == Loom.Application.Workflows.Kickoff.KickoffScope.Single ? "btn-primary" : "btn-secondary")"
                    disabled="@_busy" @onclick="() => StartAsync(Loom.Application.Workflows.Kickoff.KickoffScope.Single)">
                Single feature
            </button>
            <button type="button" class="@(c.Mode == Loom.Application.Workflows.Kickoff.KickoffScope.Multi ? "btn-primary" : "btn-secondary")"
                    disabled="@_busy" @onclick="() => StartAsync(Loom.Application.Workflows.Kickoff.KickoffScope.Multi)"
                    style="margin-left:.5rem;">
                Multi-feature initiative
            </button>
            <button type="button" class="btn-link" disabled="@_busy" @onclick="ResetClassification" style="margin-left:.75rem;">
                ← edit transcript
            </button>
        </div>
    }
</section>

<ProjectArtifactsPanel ProjectId="_form.ProjectId" />

@code {
    private bool _loadedProjects;
    private List<Project> _projects = [];
    private readonly Form _form = new();
    private bool _busy;
    private string? _error;
    private Loom.Application.Workflows.Kickoff.ScopeClassification? _classification;

    protected override async Task OnInitializedAsync()
    {
        var projects = await Projects.ListAsync();
        _projects = projects.OrderBy(p => p.Name).ToList();
        _form.ProjectId = _projects.FirstOrDefault()?.Id ?? Guid.Empty;
        _loadedProjects = true;
    }

    private async Task AnalyseAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _classification = await ScopeClassifier.ClassifyAsync(_form.Transcript);
        }
        catch (Exception ex)
        {
            // Classifier should never throw thanks to its internal
            // fallback, but if something upstream did, surface it and
            // still let the PO start the workflow manually.
            _error = $"Auto-detect failed: {ex.Message}";
            _classification = new Loom.Application.Workflows.Kickoff.ScopeClassification(
                Loom.Application.Workflows.Kickoff.KickoffScope.Single, 0.0,
                "Auto-detect unavailable.", []);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetClassification()
    {
        _classification = null;
        _error = null;
    }

    private async Task StartAsync(Loom.Application.Workflows.Kickoff.KickoffScope scope)
    {
        _busy = true;
        _error = null;
        try
        {
            var projectId = _form.ProjectId;
            if (projectId == Guid.Empty)
            {
                var def = await Features.CreateProjectAsync(
                    Slug.From("default"), "Default project", description: null);
                projectId = def.Id;
            }

            // Multi-feature kickoffs root the tree on an Initiative;
            // single-feature stays on Feature so existing flows (single
            // discovery, capabilities-under-feature) are unchanged.
            var rootType = scope == Loom.Application.Workflows.Kickoff.KickoffScope.Multi
                ? NodeType.Initiative
                : NodeType.Feature;
            var workflowKey = scope == Loom.Application.Workflows.Kickoff.KickoffScope.Multi
                ? Loom.Application.Workflows.Kickoff.KickoffMultiWorkflowFactory.WorkflowKey
                : KickoffWorkflowFactory.WorkflowKey;

            var owner = CurrentUser.GetUserId();
            var slug = Slug.From($"kickoff-{DateTime.UtcNow:yyyyMMddHHmmss}");
            var title = string.IsNullOrWhiteSpace(_form.Title) ? "Untitled" : _form.Title;
            var node = await Features.CreateRootNodeAsync(projectId, slug, rootType, title, owner);

            var workflow = await Workflows.GetCurrentByKeyAsync(Slug.From(workflowKey));
            if (workflow is null)
            {
                _error = $"{workflowKey} workflow not seeded. Restart the app or check Loom:Bootstrap configuration.";
                return;
            }

            var pausedAt = await Engine.StartAsync(node.Id, workflow.Id,
                new Dictionary<string, string> { ["transcript"] = _form.Transcript });

            if (pausedAt is null)
            {
                Nav.NavigateTo($"/n/{node.Id.Value:D}");
                return;
            }

            Nav.NavigateTo($"/runs/{pausedAt.Value.Value:D}/gate");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class Form
    {
        public Guid ProjectId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Transcript { get; set; } = string.Empty;
    }
}
