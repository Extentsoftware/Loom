@page "/settings/subscriptions"
@*
    Per-user subscription manager. Supports two scopes:
      • Node — paste a node id from the workspace URL.
      • Project — pick from the project list.
    Optional Role narrows the match; meaningful for RunPaused events.
*@

@using Loom.Application.Abstractions
@using Loom.Application.Notifications
@using Loom.Domain.Common.DomainEvents
@using Loom.Domain.Nodes
@using Loom.Domain.Notifications
@using Loom.Web.Services
@inject ISubscriptionService Subs
@inject IFeatureNodeRepository Nodes
@inject IProjectRepository Projects
@inject CurrentUserAccessor CurrentUser
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<h1 class="page-title">Notification subscriptions</h1>

<section class="ws-section">
    <div class="ws-section-header"><h2>Add subscription</h2></div>
    <div class="form-row">
        <label>Scope</label>
        <select @bind="_scope">
            <option value="node">Single node</option>
            <option value="project">Whole project</option>
            <option value="any">Any project (global)</option>
        </select>
    </div>
    @if (_scope == "node")
    {
        <div class="form-row">
            <label>Node id (paste from the workspace URL)</label>
            <input type="text" @bind="_nodeIdText" placeholder="019df848-aefc-7474-a17b-b64611525585" />
        </div>
    }
    else if (_scope == "project")
    {
        <div class="form-row">
            <label>Project</label>
            <select @bind="_projectId">
                <option value="">— pick a project —</option>
                @foreach (var p in _projects)
                {
                    <option value="@p.Id.ToString()">@p.Name</option>
                }
            </select>
        </div>
    }
    else
    {
        <p class="muted">Fires for every matching event across every project. Combine with a Role to narrow (e.g. "any UX gate anywhere").</p>
    }
    <div class="form-row">
        <label>Event</label>
        <select @bind="_eventType">
            <option value="@SubscriptionEventType.NodeUpdated">Node updated</option>
            <option value="@SubscriptionEventType.RunPaused">Run paused (gate)</option>
            <option value="@SubscriptionEventType.RunCompleted">Run completed</option>
            <option value="@SubscriptionEventType.RunFailed">Run failed</option>
        </select>
    </div>
    <div class="form-row">
        <label>Role (only used for "Run paused" gates)</label>
        <select @bind="_role">
            <option value="">Any role</option>
            <option value="@WorkflowStepGatingRole.Po">PO</option>
            <option value="@WorkflowStepGatingRole.Ux">UX</option>
            <option value="@WorkflowStepGatingRole.Lead">Lead</option>
            <option value="@WorkflowStepGatingRole.Dev">Dev</option>
        </select>
    </div>
    <div class="form-row">
        <label>Channel</label>
        <select @bind="_channel">
            <option value="@SubscriptionChannel.InApp">In-app</option>
            <option value="@SubscriptionChannel.Teams">Teams</option>
            <option value="@SubscriptionChannel.Email">Email (stub)</option>
        </select>
    </div>
    <button class="btn-primary" @onclick="AddAsync" disabled="@(!CanAdd())">Add</button>
    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error">@_error</p>
    }
</section>

<section class="ws-section">
    <div class="ws-section-header"><h2>My subscriptions</h2></div>
    @if (_subs.Count == 0)
    {
        <p class="muted">None yet.</p>
    }
    else
    {
        <table class="ws-table">
            <thead>
                <tr><th>Scope</th><th>Event</th><th>Role</th><th>Channel</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in _subs)
                {
                    <tr>
                        <td>@RenderScope(s)</td>
                        <td>@s.EventType</td>
                        <td>@(s.Role?.ToString() ?? "any")</td>
                        <td>@s.Channel</td>
                        <td><button class="btn-link" @onclick="() => RemoveAsync(s.Id)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private readonly List<Subscription> _subs = [];
    private readonly Dictionary<Guid, string> _projectNames = [];
    private readonly Dictionary<NodeId, string> _nodeTitles = [];
    private List<Loom.Domain.Nodes.Project> _projects = [];

    private string _scope = "node";
    private string _nodeIdText = string.Empty;
    private string _projectId = string.Empty;
    private SubscriptionEventType _eventType = SubscriptionEventType.RunPaused;
    private SubscriptionChannel _channel = SubscriptionChannel.InApp;
    private string _role = string.Empty; // "" | "Po" | "Ux" | "Lead"
    private string? _error;
    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        _userId = CurrentUser.GetUserId();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _projects = (await Projects.ListAsync()).ToList();
        _projectNames.Clear();
        foreach (var p in _projects) _projectNames[p.Id] = p.Name;

        _subs.Clear();
        _subs.AddRange(await Subs.ListMineAsync(_userId));

        _nodeTitles.Clear();
        foreach (var s in _subs)
        {
            if (s.NodeId is null) continue;
            if (_nodeTitles.ContainsKey(s.NodeId.Value)) continue;
            var n = await Nodes.GetAsync(s.NodeId.Value);
            if (n is not null) _nodeTitles[s.NodeId.Value] = n.Title;
        }
        StateHasChanged();
    }

    private bool CanAdd()
    {
        if (_scope == "node") return !string.IsNullOrWhiteSpace(_nodeIdText);
        if (_scope == "project") return !string.IsNullOrWhiteSpace(_projectId);
        return true; // "any" scope has no further inputs
    }

    private async Task AddAsync()
    {
        _error = null;
        WorkflowStepGatingRole? role = string.IsNullOrEmpty(_role)
            ? null
            : Enum.Parse<WorkflowStepGatingRole>(_role);
        try
        {
            if (_scope == "node")
            {
                if (!Guid.TryParse(_nodeIdText.Trim(), out var nodeGuid))
                {
                    _error = "That doesn't look like a node id.";
                    return;
                }
                await Subs.SubscribeNodeAsync(_userId, new NodeId(nodeGuid), _eventType, _channel, SubscriptionMode.Realtime, role);
                _nodeIdText = string.Empty;
            }
            else if (_scope == "project")
            {
                if (!Guid.TryParse(_projectId, out var projGuid))
                {
                    _error = "Pick a project.";
                    return;
                }
                await Subs.SubscribeProjectAsync(_userId, projGuid, _eventType, _channel, SubscriptionMode.Realtime, role);
                _projectId = string.Empty;
            }
            else
            {
                await Subs.SubscribeGlobalAsync(_userId, _eventType, _channel, SubscriptionMode.Realtime, role);
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RemoveAsync(SubscriptionId id)
    {
        await Subs.UnsubscribeAsync(id);
        await LoadAsync();
    }

    private RenderFragment RenderScope(Subscription s) => builder =>
    {
        var seq = 0;
        if (s.NodeId is { } n)
        {
            var label = _nodeTitles.TryGetValue(n, out var t) ? t : n.Value.ToString("N");
            builder.OpenElement(seq++, "a");
            builder.AddAttribute(seq++, "href", $"/n/{n.Value:D}");
            builder.AddContent(seq++, label);
            builder.CloseElement();
        }
        else if (s.ProjectId is { } p)
        {
            var name = _projectNames.TryGetValue(p, out var pn) ? pn : p.ToString("N");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "badge");
            builder.AddContent(seq++, $"project: {name}");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "badge");
            builder.AddContent(seq++, "any project");
            builder.CloseElement();
        }
    };
}
