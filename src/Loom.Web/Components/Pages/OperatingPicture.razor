@*
    Operating Picture — the tree home. Recursive descent through the
    project's nodes, with derived StatusSignals on each row. Subscribes to
    NodeHub and re-fetches the tree when a node update arrives. Multiple
    projects: lists each project; v1 deployments typically host one.
*@

@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@rendermode InteractiveServer

@inject IFeatureService Features
@inject IProjectRepository Projects
@inject NavigationManager Nav

<PageTitle>Operating picture · Loom</PageTitle>

<header class="page-head">
    <h1 class="page-title">Operating <em>picture</em></h1>
    <p class="page-meta">
        @if (_loaded)
        {
            <span>@_totalNodes nodes</span>
            <span>@_trees.Count project@(_trees.Count == 1 ? "" : "s")</span>
            <span>updated @DateTime.UtcNow.ToString("HH:mm")</span>
        }
        else
        {
            <span>loading…</span>
        }
    </p>
    <nav class="page-actions">
        <a href="/kickoff" class="btn-primary">+ Kickoff a new feature</a>
        <button type="button" class="btn-secondary" @onclick="ToggleCreateProject">
            @(_creating ? "Cancel" : "+ New project")
        </button>
        <button type="button" class="btn-secondary" @onclick="ToggleShowArchivedAsync">
            @(_showArchived ? "Hide archived" : "Show archived")
        </button>
        <a href="/fragments" class="btn-secondary">Fragments</a>
    </nav>
</header>

@if (_creating)
{
    <section class="ws-section">
        <EditForm Model="_newProject" OnValidSubmit="CreateProjectAsync">
            <div class="form-row">
                <label>Slug</label>
                <input @bind="_newProject.Slug" placeholder="acme-marketplace" required />
            </div>
            <div class="form-row">
                <label>Name</label>
                <input @bind="_newProject.Name" placeholder="Acme Marketplace" required />
            </div>
            <div class="form-row">
                <label>Description (optional)</label>
                <input @bind="_newProject.Description" placeholder="Short summary" />
            </div>
            @if (!string.IsNullOrEmpty(_createError))
            {
                <p class="error">@_createError</p>
            }
            <button type="submit" class="btn-primary" disabled="@_creatingBusy">
                @(_creatingBusy ? "Creating…" : "Create project")
            </button>
        </EditForm>
    </section>
}

@if (!_loaded)
{
    <p class="loading">Loading…</p>
}
else if (_trees.Count == 0)
{
    <section class="empty-state">
        <h2>No project yet.</h2>
        <p>
            Loom needs a project to work against. Run the seed tool, or
            kick off a feature — the kickoff page will create a default
            project on first use.
        </p>
        <pre class="code-hint">dotnet run --project tools/seed</pre>
    </section>
}
else
{
    @foreach (var tree in _trees)
    {
        var isArchived = _archivedById.TryGetValue(tree.ProjectId, out var arch) && arch;
        <article class="tree-init" style="@(isArchived ? "opacity:.6;" : "")">
            <header class="init-head">
                @if (_renamingProjectId == tree.ProjectId)
                {
                    <span class="init-title">
                        <input @bind="_projectNameDraft" @bind:event="oninput" @onkeydown="@(e => OnRenameProjectKey(e, tree.ProjectId))" />
                        <button class="btn-link" @onclick="@(() => SaveRenameProjectAsync(tree.ProjectId))" disabled="@_renameProjectBusy" title="Save">✓</button>
                        <button class="btn-link" @onclick="CancelRenameProject" title="Cancel">✕</button>
                    </span>
                }
                else
                {
                    <span class="init-title">
                        @tree.ProjectName
                        @if (isArchived)
                        {
                            <span class="badge" style="margin-left:.5rem;">archived</span>
                        }
                        <button class="btn-link" title="Rename project" @onclick="@(() => StartRenameProject(tree.ProjectId, tree.ProjectName))" style="font-size:.8em; margin-left:.5rem;">✎</button>
                        @if (isArchived)
                        {
                            <button class="btn-link" title="Restore" @onclick="@(() => UnarchiveProjectAsync(tree.ProjectId))" style="font-size:.8em; margin-left:.25rem;">↺</button>
                        }
                        else
                        {
                            <button class="btn-link" title="Archive project" @onclick="@(() => ArchiveProjectAsync(tree.ProjectId))" style="font-size:.8em; margin-left:.25rem;">🗄</button>
                        }
                    </span>
                }
                <span class="init-meta">@CountNodes(tree.Roots) nodes</span>
            </header>
            @if (_renamingProjectId == tree.ProjectId && !string.IsNullOrEmpty(_renameProjectError))
            {
                <p class="error">@_renameProjectError</p>
            }
            @if (tree.Roots.Count == 0)
            {
                <p class="init-empty">No nodes yet.</p>
            }
            else
            {
                <div class="tree">
                    @foreach (var row in tree.Roots)
                    {
                        <NodeRow Row="row" Depth="0" />
                    }
                </div>
            }
        </article>
    }
}

@code {
    private bool _loaded;
    private List<NodeTreeView> _trees = [];
    private int _totalNodes;
    private HubConnection? _hub;

    private bool _creating;
    private bool _creatingBusy;
    private string? _createError;
    private NewProjectForm _newProject = new();

    private Guid? _renamingProjectId;
    private string _projectNameDraft = string.Empty;
    private bool _renameProjectBusy;
    private string? _renameProjectError;

    private bool _showArchived;
    private Dictionary<Guid, bool> _archivedById = [];

    private sealed class NewProjectForm
    {
        public string Slug { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }

    private void ToggleCreateProject()
    {
        _creating = !_creating;
        if (_creating)
        {
            _newProject = new NewProjectForm();
            _createError = null;
        }
    }

    private async Task CreateProjectAsync()
    {
        if (_creatingBusy)
        {
            return;
        }
        _creatingBusy = true;
        _createError = null;
        try
        {
            var slug = Loom.Domain.Common.Slug.From(_newProject.Slug.Trim());
            await Features.CreateProjectAsync(
                slug,
                _newProject.Name.Trim(),
                string.IsNullOrWhiteSpace(_newProject.Description) ? null : _newProject.Description.Trim());
            _creating = false;
            await LoadAsync();
        }
        catch (Loom.Domain.Common.DomainException ex)
        {
            _createError = ex.Message;
        }
        catch (ArgumentException ex)
        {
            _createError = ex.Message;
        }
        finally
        {
            _creatingBusy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _hub is null)
        {
            // Connect to the NodeHub to refresh the tree on any node update.
            // We don't join per-node groups here; the home page wants a
            // global "anything changed" signal. Phase 3 adds per-project
            // groups to scope the fan-out.
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/node"))
                .WithAutomaticReconnect()
                .Build();
            _hub.On<object>("node-updated", _ => InvokeAsync(LoadAsync));
            _hub.On<object>("discovery-accepted", _ => InvokeAsync(LoadAsync));
            _hub.On<object>("node-phase-advanced", _ => InvokeAsync(LoadAsync));
            try
            {
                await _hub.StartAsync();
            }
            catch
            {
                // SignalR is best-effort here — the page still renders the
                // last-fetched tree if the hub fails to start.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }

    private async Task LoadAsync()
    {
        var projects = _showArchived
            ? await Projects.ListAllAsync()
            : await Projects.ListAsync();
        _archivedById = projects.ToDictionary(p => p.Id, p => p.IsArchived);
        var trees = new List<NodeTreeView>(projects.Count);
        var total = 0;
        foreach (var project in projects)
        {
            var tree = await Features.GetTreeAsync(project.Id);
            trees.Add(tree);
            total += CountNodes(tree.Roots);
        }
        _trees = trees;
        _totalNodes = total;
        _loaded = true;
        StateHasChanged();
    }

    private async Task ToggleShowArchivedAsync()
    {
        _showArchived = !_showArchived;
        await LoadAsync();
    }

    private async Task ArchiveProjectAsync(Guid projectId)
    {
        try
        {
            await Features.ArchiveProjectAsync(projectId);
            await LoadAsync();
        }
        catch (Loom.Domain.Common.DomainException)
        {
            // Already archived — refresh and ignore.
            await LoadAsync();
        }
    }

    private async Task UnarchiveProjectAsync(Guid projectId)
    {
        try
        {
            await Features.UnarchiveProjectAsync(projectId);
            await LoadAsync();
        }
        catch (Loom.Domain.Common.DomainException)
        {
            await LoadAsync();
        }
    }

    private void StartRenameProject(Guid projectId, string currentName)
    {
        _renamingProjectId = projectId;
        _projectNameDraft = currentName;
        _renameProjectError = null;
    }

    private void CancelRenameProject()
    {
        _renamingProjectId = null;
        _renameProjectError = null;
    }

    private async Task OnRenameProjectKey(KeyboardEventArgs e, Guid projectId)
    {
        if (e.Key == "Enter")
        {
            await SaveRenameProjectAsync(projectId);
        }
        else if (e.Key == "Escape")
        {
            CancelRenameProject();
        }
    }

    private async Task SaveRenameProjectAsync(Guid projectId)
    {
        if (_renameProjectBusy) return;
        var newName = (_projectNameDraft ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(newName))
        {
            _renameProjectError = "Name can't be empty.";
            return;
        }
        _renameProjectBusy = true;
        _renameProjectError = null;
        try
        {
            await Features.RenameProjectAsync(projectId, newName);
            _renamingProjectId = null;
            await LoadAsync();
        }
        catch (Loom.Domain.Common.DomainException ex)
        {
            _renameProjectError = ex.Message;
        }
        finally
        {
            _renameProjectBusy = false;
        }
    }

    private static int CountNodes(IReadOnlyList<NodeTreeRow> rows)
    {
        var n = 0;
        foreach (var row in rows)
        {
            n += 1 + CountNodes(row.Children);
        }
        return n;
    }
}
