    {
        _editingHypotheses = false;
        _hypothesesError = null;
    }

    private void AddHypothesisRow() => _hypothesisDrafts.Add(new HypothesisDraft());

    private void RemoveHypothesisRow(int index)
    {
        if (index >= 0 && index < _hypothesisDrafts.Count)
        {
            _hypothesisDrafts.RemoveAt(index);
        }
    }

    private async Task SaveHypothesesAsync()
    {
        if (_view is null || _hypothesesBusy) return;
        _hypothesesBusy = true;
        _hypothesesError = null;
        try
        {
            // Drop fully-empty rows; require all three fields on the rest.
            var cleaned = _hypothesisDrafts
                .Select(d => new
                {
                    If = (d.If ?? string.Empty).Trim(),
                    Then = (d.Then ?? string.Empty).Trim(),
                    Because = (d.Because ?? string.Empty).Trim()
                })
                .Where(d => !(string.IsNullOrEmpty(d.If) && string.IsNullOrEmpty(d.Then) && string.IsNullOrEmpty(d.Because)))
                .ToList();
            if (cleaned.Any(d => string.IsNullOrEmpty(d.If) || string.IsNullOrEmpty(d.Then) || string.IsNullOrEmpty(d.Because)))
            {
                _hypothesesError = "Each hypothesis needs all three parts (If / Then / Because). Remove the row to drop it.";
                return;
            }
            var hypotheses = cleaned
                .Select(d => new Loom.Domain.Nodes.Hypothesis(d.If, d.Then, d.Because))
                .ToList();
            await Features.ReplaceHypothesesAsync(_view.NodeId, hypotheses, CurrentUser.GetUserId());
            _editingHypotheses = false;
            await LoadAsync();
        }
        catch (Loom.Domain.Common.DomainException ex)
        {
            _hypothesesError = ex.Message;
        }
        finally
        {
            _hypothesesBusy = false;
        }
    }

    private void ToggleAttachArtifact()
    {
        _attachingArtifact = !_attachingArtifact;
        if (_attachingArtifact)
        {
            _attachDraft = new AttachArtifactDraft();
            _attachError = null;
        }
    }

    private async Task SaveAttachAsync()
    {
        if (_view is null || _attachBusy) return;
        var title = (_attachDraft.Title ?? string.Empty).Trim();
        var url = (_attachDraft.Url ?? string.Empty).Trim();
        var externalId = (_attachDraft.ExternalId ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(title))
        {
            _attachError = "Title is required.";
            return;
        }
        // For non-HubNative stores, require either a URL or an External id —
        // we need *something* to address the canonical content.
        if (_attachDraft.Store != Loom.Domain.Artifacts.CanonicalStore.HubNative
            && string.IsNullOrEmpty(url) && string.IsNullOrEmpty(externalId))
        {
            _attachError = "Provide a URL or external id for non-hub-native artifacts.";
            return;
        }
        _attachBusy = true;
        _attachError = null;
        try
        {
            var canonical = new Loom.Domain.Artifacts.CanonicalPointer(
                Store: _attachDraft.Store,
                ExternalId: string.IsNullOrEmpty(externalId) ? (url ?? string.Empty) : externalId,
                Url: string.IsNullOrEmpty(url) ? null : url);
            await Artifacts.CreateAsync(_view.NodeId, _attachDraft.Kind, title, canonical);
            _attachingArtifact = false;
            await LoadAsync();
        }
        catch (Loom.Domain.Common.DomainException ex)
        {
            _attachError = ex.Message;
        }
        finally
        {
            _attachBusy = false;
        }
    }

