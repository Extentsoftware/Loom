    private async Task ArchiveAsync()
    {
        if (_view is null || _archivingBusy) return;
        _archivingBusy = true;
        try
        {
            await Features.AdvancePhaseAsync(_view.NodeId, NodePhase.Archived);
            Nav.NavigateTo("/");
        }
        catch (Loom.Domain.Common.DomainException)
        {
            _archivingBusy = false;
            // Stay on the page; the Advance call's domain error will be
            // surfaced via the next LoadAsync() phase reading.
            await LoadAsync();
        }
    }

    private static NodePhase? NextPhase(NodePhase? from) => from switch
    {
        NodePhase.Discovery => NodePhase.Enrich,
        NodePhase.Enrich => NodePhase.Build,
        NodePhase.Build => NodePhase.Test,
        NodePhase.Test => NodePhase.Done,
        _ => null
    };
