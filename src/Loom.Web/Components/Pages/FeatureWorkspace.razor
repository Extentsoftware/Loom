@*
    Feature Workspace — single-node detail view. Shows intent, outcomes,
    hypotheses, open questions, stakeholders, children, recent runs, and
    a phase-advance button. Subscribes to NodeHub for live updates so a
    completing run or accepted discovery refreshes the page in place.
*@

@page "/n/{NodeId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IFeatureService Features
@inject IArtifactRepository ArtifactRepo
@inject Loom.Application.Artifacts.IArtifactService Artifacts
@inject IWorkflowEngine Engine
@inject IWorkflowRepository Workflows
@inject IServiceScopeFactory ScopeFactory
@inject Loom.Web.Services.CurrentUserAccessor CurrentUser
@inject NavigationManager Nav

<PageTitle>@(_view?.Title ?? "Loading…") · Loom</PageTitle>

@if (!_loaded)
{
    <p class="loading">Loading…</p>
}
else if (_view is null)
{
    <section class="empty-state">
        <h2>Node not found.</h2>
        <p><a href="/">Back to Operating Picture</a></p>
    </section>
}
else
{
    <header class="page-head">
        <p class="page-meta">
            <a href="/">← Operating Picture</a>
        </p>
        @if (_renaming)
        {
            <div class="form-row" style="display:flex; gap:.5rem; align-items:center;">
                <input @bind="_titleDraft" @bind:event="oninput" @onkeydown="OnRenameKey" placeholder="Title" />
                <button class="btn-primary" @onclick="SaveRenameAsync" disabled="@_renamingBusy">Save</button>
                <button class="btn-secondary" @onclick="CancelRename">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_renameError))
            {
                <p class="error">@_renameError</p>
            }
        }
        else
        {
            <h1 class="page-title">
                @_view.Title
                <button class="btn-link" title="Rename" @onclick="StartRename" style="margin-left:.5rem; font-size:.8em;">✎</button>
            </h1>
        }
        <p class="page-meta">
            <PhasePill Phase="_view.Phase" />
            <span class="tree-type">@_view.Type.ToString().ToUpperInvariant()</span>
            <StatusPulseBadge Signals="_view.Status" />
            @if (_nextPhase is not null)
            {
                <button class="btn-secondary" @onclick="AdvanceAsync">Advance to @_nextPhase</button>
            }
            @if (_view.Phase != NodePhase.Archived)
            {
                <button class="btn-secondary" @onclick="ArchiveAsync" disabled="@_archivingBusy">
                    @(_archivingBusy ? "Archiving…" : "Archive")
                </button>
                <button class="btn-secondary" @onclick="@(() => RunWorkflowAsync(Loom.Application.Workflows.Wireframing.WireframingWorkflowFactory.WorkflowKey))"
                        disabled="@_workflowBusy" title="Generate a wireframe for UX review">
                    Run wireframing
                </button>
                <button class="btn-secondary" @onclick="@(() => RunWorkflowAsync(Loom.Application.Workflows.Engineering.SliceDesignWorkflowFactory.WorkflowKey))"
                        disabled="@_workflowBusy" title="Propose a slice design for tech-lead review">
                    Run slice design
                </button>
                <button class="btn-secondary" @onclick="@(() => RunWorkflowAsync(Loom.Application.Workflows.Engineering.BuildWorkflowFactory.WorkflowKey))"
                        disabled="@_workflowBusy" title="Propose an implementation plan for the assigned dev">
                    Run build
                </button>
                <button class="btn-secondary" @onclick="@(() => RunWorkflowAsync(Loom.Application.Workflows.Engineering.TestPlanWorkflowFactory.WorkflowKey))"
                        disabled="@_workflowBusy" title="Derive a test plan from the acceptance criteria">
                    Run test plan
                </button>
            }
            @if (_workflowBusy)
            {
                <span class="muted" style="margin-left:.5rem;">Starting…</span>
            }
            @if (_workflowError is not null)
            {
                <span class="error" style="margin-left:.5rem;">@_workflowError</span>
            }
        </p>
    </header>

    <section class="ws-section">
        <h2>
            Intent
            @if (!_editingIntent)
            {
                <button class="btn-link" title="Edit intent" @onclick="StartEditIntent" style="font-size:.7em; margin-left:.5rem;">✎</button>
            }
        </h2>
        @if (_editingIntent)
        {
            <textarea rows="4" style="width:100%;" @bind="_intentDraft" @bind:event="oninput"></textarea>
            <div style="margin-top:.5rem; display:flex; gap:.5rem;">
                <button class="btn-primary" @onclick="SaveIntentAsync" disabled="@_intentBusy">
                    @(_intentBusy ? "Saving…" : "Save")
                </button>
                <button class="btn-secondary" @onclick="CancelEditIntent">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_intentError))
            {
                <p class="error">@_intentError</p>
            }
        }
        else if (string.IsNullOrWhiteSpace(_view.Intent))
        {
            <p class="muted">No intent set.</p>
        }
        else
        {
            <p>@_view.Intent</p>
        }
    </section>

    <section class="ws-section">
        <h2>
            Outcomes (@_view.Outcomes.Count)
            @if (!_editingOutcomes)
            {
                <button class="btn-link" title="Edit outcomes" @onclick="StartEditOutcomes" style="font-size:.7em; margin-left:.5rem;">✎</button>
            }
        </h2>
        @if (_editingOutcomes)
        {
            <p class="muted">Each outcome: a statement, optional metric hint, and whether it's measurable.</p>
            @for (var i = 0; i < _outcomeDrafts.Count; i++)
            {
                var idx = i;
                <div class="form-row" style="display:flex; gap:.5rem; align-items:center; margin-bottom:.5rem;">
                    <input @bind="_outcomeDrafts[idx].Statement" placeholder="Outcome statement" style="flex:2;" />
                    <input @bind="_outcomeDrafts[idx].MetricHint" placeholder="Metric hint (optional)" style="flex:1;" />
                    <label style="display:flex; align-items:center; gap:.25rem;">
                        <input type="checkbox" @bind="_outcomeDrafts[idx].Measurable" />
                        measurable
                    </label>
                    <button class="btn-link" title="Remove" @onclick="@(() => _outcomeDrafts.RemoveAt(idx))">✕</button>
                </div>
            }
            <div style="margin-top:.5rem; display:flex; gap:.5rem;">
                <button class="btn-secondary" @onclick="@(() => _outcomeDrafts.Add(new OutcomeDraft()))">+ Add outcome</button>
                <button class="btn-primary" @onclick="SaveOutcomesAsync" disabled="@_outcomesBusy">
                    @(_outcomesBusy ? "Saving…" : "Save")
                </button>
                <button class="btn-secondary" @onclick="@(() => _editingOutcomes = false)">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_outcomesError))
            {
                <p class="error">@_outcomesError</p>
            }
        }
        else if (_view.Outcomes.Count == 0)
        {
            <p class="muted">None yet.</p>
        }
        else
        {
            <ul>
                @foreach (var o in _view.Outcomes)
                {
                    <li>
                        @o.Statement
                        @if (o.Measurable) { <span class="badge">measurable</span> }
                        @if (!string.IsNullOrWhiteSpace(o.MetricHint)) { <span class="muted"> — @o.MetricHint</span> }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="ws-section">
        <h2>
            Hypotheses (@_view.Hypotheses.Count)
            @if (!_editingHypotheses)
            {
                <button class="btn-link" title="Edit hypotheses" @onclick="StartEditHypotheses" style="font-size:.7em; margin-left:.5rem;">✎</button>
            }
        </h2>
        @if (_editingHypotheses)
        {
            <p class="muted">Each hypothesis: <em>If [condition] then [effect] because [mechanism]</em>. Falsifiable, not assumed.</p>
            @for (var i = 0; i < _hypothesisDrafts.Count; i++)
            {
                var idx = i;
                <div class="form-row" style="display:flex; gap:.5rem; align-items:center; margin-bottom:.5rem;">
                    <span style="min-width:1.5rem; opacity:.6;">If</span>
                    <input @bind="_hypothesisDrafts[idx].If" placeholder="condition" style="flex:1;" />
                    <span style="opacity:.6;">then</span>
                    <input @bind="_hypothesisDrafts[idx].Then" placeholder="effect" style="flex:1;" />
                    <span style="opacity:.6;">because</span>
                    <input @bind="_hypothesisDrafts[idx].Because" placeholder="mechanism" style="flex:1;" />
                    <button class="btn-link" title="Remove" @onclick="@(() => RemoveHypothesisRow(idx))">✕</button>
                </div>
            }
            <div style="margin-top:.5rem; display:flex; gap:.5rem;">
                <button class="btn-secondary" @onclick="AddHypothesisRow">+ Add hypothesis</button>
                <button class="btn-primary" @onclick="SaveHypothesesAsync" disabled="@_hypothesesBusy">
                    @(_hypothesesBusy ? "Saving…" : "Save")
                </button>
                <button class="btn-secondary" @onclick="CancelEditHypotheses">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_hypothesesError))
            {
                <p class="error">@_hypothesesError</p>
            }
        }
        else if (_view.Hypotheses.Count == 0)
        {
            <p class="muted">None yet.</p>
        }
        else
        {
            <ul>
                @foreach (var h in _view.Hypotheses)
                {
                    <li><strong>If</strong> @h.If <strong>then</strong> @h.Then <em>because</em> @h.Because</li>
                }
            </ul>
        }
    </section>

    <section class="ws-section">
        <h2>
            Open questions (@_view.OpenQuestions.Count)
            @if (!_editingQuestions)
            {
                <button class="btn-link" title="Edit open questions" @onclick="StartEditQuestions" style="font-size:.7em; margin-left:.5rem;">✎</button>
            }
        </h2>
        @if (_editingQuestions)
        {
            <textarea rows="6" style="width:100%;" @bind="_questionsDraft" placeholder="One question per line. Empty lines dropped on save."></textarea>
            <div style="margin-top:.5rem; display:flex; gap:.5rem;">
                <button class="btn-primary" @onclick="SaveQuestionsAsync" disabled="@_questionsBusy">
                    @(_questionsBusy ? "Saving…" : "Save")
                </button>
                <button class="btn-secondary" @onclick="@(() => _editingQuestions = false)">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_questionsError))
            {
                <p class="error">@_questionsError</p>
            }
        }
        else if (_view.OpenQuestions.Count == 0)
        {
            <p class="muted">None.</p>
        }
        else
        {
            <ul>
                @foreach (var q in _view.OpenQuestions)
                {
                    <li>@q</li>
                }
            </ul>
        }
    </section>

    <section class="ws-section">
        <h2>
            Stakeholders (@_view.Stakeholders.Count)
            @if (!_editingStakeholders)
            {
                <button class="btn-link" title="Edit stakeholders" @onclick="StartEditStakeholders" style="font-size:.7em; margin-left:.5rem;">✎</button>
            }
        </h2>
        @if (_editingStakeholders)
        {
            @for (var i = 0; i < _stakeholderDrafts.Count; i++)
            {
                var idx = i;
                <div class="form-row" style="display:flex; gap:.5rem; align-items:center; margin-bottom:.5rem;">
                    <input @bind="_stakeholderDrafts[idx].Name" placeholder="Name" style="flex:1;" />
                    <input @bind="_stakeholderDrafts[idx].Role" placeholder="Role (PO, UX, tech-lead…)" style="flex:1;" />
                    <input @bind="_stakeholderDrafts[idx].Interest" placeholder="Interest (optional)" style="flex:1;" />
                    <button class="btn-link" title="Remove" @onclick="@(() => _stakeholderDrafts.RemoveAt(idx))">✕</button>
                </div>
            }
            <div style="margin-top:.5rem; display:flex; gap:.5rem;">
                <button class="btn-secondary" @onclick="@(() => _stakeholderDrafts.Add(new StakeholderDraft()))">+ Add stakeholder</button>
                <button class="btn-primary" @onclick="SaveStakeholdersAsync" disabled="@_stakeholdersBusy">
                    @(_stakeholdersBusy ? "Saving…" : "Save")
                </button>
                <button class="btn-secondary" @onclick="@(() => _editingStakeholders = false)">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_stakeholdersError))
            {
                <p class="error">@_stakeholdersError</p>
            }
        }
        else if (_view.Stakeholders.Count == 0)
        {
            <p class="muted">None.</p>
        }
        else
        {
            <ul>
                @foreach (var s in _view.Stakeholders)
                {
                    <li>
                        <strong>@s.Name</strong>
                        <span class="muted"> · @s.Role</span>
                        @if (!string.IsNullOrWhiteSpace(s.Interest)) { <span class="muted"> — @s.Interest</span> }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="ws-section">
        <h2>
            Constraints (@_view.Constraints.Count)
            @if (!_editingConstraints)
            {
                <button class="btn-link" title="Edit constraints" @onclick="StartEditConstraints" style="font-size:.7em; margin-left:.5rem;">✎</button>
            }
        </h2>
        @if (_editingConstraints)
        {
            <p class="muted">A constraint is a boundary the feature must respect. The kind drives downstream gating (e.g. regulatory pulls in a compliance fragment).</p>
            @for (var i = 0; i < _constraintDrafts.Count; i++)
            {
                var idx = i;
                <div class="form-row" style="display:flex; gap:.5rem; align-items:center; margin-bottom:.5rem;">
                    <select @bind="_constraintDrafts[idx].Kind" style="flex:0 0 9rem;">
                        @foreach (var k in Enum.GetValues<Loom.Domain.Nodes.ConstraintKind>())
                        {
                            <option value="@k">@k</option>
                        }
                    </select>
                    <input @bind="_constraintDrafts[idx].Detail" placeholder="What the constraint says" style="flex:1;" />
                    <button class="btn-link" title="Remove" @onclick="@(() => _constraintDrafts.RemoveAt(idx))">✕</button>
                </div>
            }
            <div style="margin-top:.5rem; display:flex; gap:.5rem;">
                <button class="btn-secondary" @onclick="@(() => _constraintDrafts.Add(new ConstraintDraft()))">+ Add constraint</button>
                <button class="btn-primary" @onclick="SaveConstraintsAsync" disabled="@_constraintsBusy">
                    @(_constraintsBusy ? "Saving…" : "Save")
                </button>
                <button class="btn-secondary" @onclick="@(() => _editingConstraints = false)">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_constraintsError))
            {
                <p class="error">@_constraintsError</p>
            }
        }
        else if (_view.Constraints.Count == 0)
        {
            <p class="muted">None.</p>
        }
        else
        {
            <ul>
                @foreach (var c in _view.Constraints)
                {
                    <li><span class="badge">@c.Kind</span> @c.Detail</li>
                }
            </ul>
        }
    </section>

    <section class="ws-section">
        <h2>Children (@_view.Children.Count)</h2>
        @if (_view.Children.Count == 0)
        {
            <p class="muted">No children.</p>
        }
        else
        {
            <div class="tree">
                @foreach (var c in _view.Children)
                {
                    <NodeRow Row="c" Depth="0" />
                }
            </div>
        }
    </section>

    <section class="ws-section">
        <h2>
            Artifacts (@_artifacts.Count)
            <button class="btn-link" title="Attach an artifact" @onclick="ToggleAttachArtifact" style="font-size:.7em; margin-left:.5rem;">
                @(_attachingArtifact ? "✕" : "+ Attach")
            </button>
        </h2>
        @if (_attachingArtifact)
        {
            <div class="form-row" style="display:grid; grid-template-columns: 1fr 1fr; gap:.5rem; margin-bottom:.5rem;">
                <label>
                    Title
                    <input @bind="_attachDraft.Title" placeholder="e.g. PSD2 SCA flow wireframe" />
                </label>
                <label>
                    Kind
                    <select @bind="_attachDraft.Kind">
                        @foreach (var k in Enum.GetValues<Loom.Domain.Artifacts.ArtifactKind>())
                        {
                            <option value="@k">@k</option>
                        }
                    </select>
                </label>
                <label>
                    Store
                    <select @bind="_attachDraft.Store">
                        @foreach (var s in Enum.GetValues<Loom.Domain.Artifacts.CanonicalStore>())
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </label>
                <label>
                    URL
                    <input @bind="_attachDraft.Url" placeholder="https://figma.com/file/... or git blob URL" />
                </label>
                <label style="grid-column:1 / span 2;">
                    External id (optional — Figma node id, git sha, Confluence page id…)
                    <input @bind="_attachDraft.ExternalId" placeholder="optional" />
                </label>
            </div>
            <div style="display:flex; gap:.5rem;">
                <button class="btn-primary" @onclick="SaveAttachAsync" disabled="@_attachBusy">
                    @(_attachBusy ? "Attaching…" : "Attach artifact")
                </button>
                <button class="btn-secondary" @onclick="ToggleAttachArtifact">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_attachError))
            {
                <p class="error">@_attachError</p>
            }
        }
        @if (_artifacts.Count == 0)
        {
            <p class="muted">No artifacts attached.</p>
        }
        else
        {
            <ul class="artifact-list">
                @foreach (var a in _artifacts)
                {
                    <li>
                        <a href="@($"/artifacts/{a.Id.Value:D}")">@a.Title</a>
                        <span class="muted"> · @a.Kind · v@(a.CurrentVersion?.VersionNumber ?? 0)</span>
                        @if (a.Canonical.Url is not null)
                        {
                            <span class="muted"> · </span>
                            <a href="@a.Canonical.Url" target="_blank" rel="noopener">@a.Canonical.Store</a>
                        }
                        @if (a.Lock is not null && a.Lock.IsActiveAt(DateTimeOffset.UtcNow))
                        {
                            <span class="muted"> · 🔒 locked</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="ws-section">
        <h2>Recent runs (@_view.RecentRuns.Count)</h2>
        @if (_view.RecentRuns.Count == 0)
        {
            <p class="muted">No runs yet.</p>
        }
        else
        {
            <table class="run-table">
                <thead><tr><th>Engine</th><th>State</th><th>Created</th><th>Cost</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _view.RecentRuns)
                    {
                        <tr>
                            <td>@r.Engine</td>
                            <td>@r.State</td>
                            <td>@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(r.CostUsd is decimal d ? $"${d:F4}" : "—")</td>
                            <td>
                                <a href="@($"/runs/{r.RunId.Value:D}")">detail</a>
                                @if (r.State == Loom.Domain.Runs.RunState.PausedForHuman)
                                {
                                    <span> · </span>
                                    <a href="@($"/runs/{r.RunId.Value:D}/gate")">gate</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    [Parameter] public Guid NodeId { get; set; }

    private bool _loaded;
    private FeatureWorkspaceView? _view;
    private NodePhase? _nextPhase;
    private HubConnection? _hub;
    private IReadOnlyList<Loom.Domain.Artifacts.Artifact> _artifacts = [];

    private bool _renaming;
    private bool _renamingBusy;
    private string _titleDraft = string.Empty;
    private string? _renameError;
    private bool _archivingBusy;

    private bool _editingIntent;
    private string _intentDraft = string.Empty;
    private bool _intentBusy;
    private string? _intentError;

    private bool _editingHypotheses;
    private List<HypothesisDraft> _hypothesisDrafts = [];
    private bool _hypothesesBusy;
    private string? _hypothesesError;

    private bool _attachingArtifact;
    private bool _attachBusy;
    private string? _attachError;
    private AttachArtifactDraft _attachDraft = new();

    private sealed class AttachArtifactDraft
    {
        public string Title { get; set; } = string.Empty;
        public Loom.Domain.Artifacts.ArtifactKind Kind { get; set; } = Loom.Domain.Artifacts.ArtifactKind.Doc;
        public Loom.Domain.Artifacts.CanonicalStore Store { get; set; } = Loom.Domain.Artifacts.CanonicalStore.HubNative;
        public string Url { get; set; } = string.Empty;
        public string ExternalId { get; set; } = string.Empty;
    }

    private bool _editingOutcomes;
    private List<OutcomeDraft> _outcomeDrafts = [];
    private bool _outcomesBusy;
    private string? _outcomesError;

    private sealed class OutcomeDraft
    {
        public string Statement { get; set; } = string.Empty;
        public string MetricHint { get; set; } = string.Empty;
        public bool Measurable { get; set; }
    }

    private bool _editingQuestions;
    private string _questionsDraft = string.Empty;
    private bool _questionsBusy;
    private string? _questionsError;

    private bool _editingStakeholders;
    private List<StakeholderDraft> _stakeholderDrafts = [];
    private bool _stakeholdersBusy;
    private string? _stakeholdersError;

    private sealed class StakeholderDraft
    {
        public string Name { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string Interest { get; set; } = string.Empty;
    }

    private bool _editingConstraints;
    private List<ConstraintDraft> _constraintDrafts = [];
    private bool _constraintsBusy;
    private string? _constraintsError;

    private sealed class ConstraintDraft
    {
        public Loom.Domain.Nodes.ConstraintKind Kind { get; set; } = Loom.Domain.Nodes.ConstraintKind.Other;
        public string Detail { get; set; } = string.Empty;
    }

    private sealed class HypothesisDraft
    {
        public string If { get; set; } = string.Empty;
        public string Then { get; set; } = string.Empty;
        public string Because { get; set; } = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _hub is null)
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/node"))
                .WithAutomaticReconnect()
                .Build();
            _hub.On<object>("node-updated", _ => InvokeAsync(SafeReloadAsync));
            _hub.On<object>("discovery-accepted", _ => InvokeAsync(SafeReloadAsync));
            _hub.On<object>("node-phase-advanced", _ => InvokeAsync(SafeReloadAsync));
            _hub.On<object>("run-state-changed", _ => InvokeAsync(SafeReloadAsync));
            try
            {
                await _hub.StartAsync();
                await _hub.SendAsync("JoinNode", NodeId);
            }
            catch
            {
                // Best-effort live updates.
            }
        }
    }

    private bool _disposing;
    public async ValueTask DisposeAsync()
    {
        _disposing = true;
        if (_hub is not null)
        {
            try { await _hub.SendAsync("LeaveNode", NodeId); } catch { /* ignore */ }
            await _hub.DisposeAsync();
        }
    }

    // SignalR notifications can race the page's own LoadAsync (originated
    // by OnParametersSetAsync, button clicks, etc.). They share the
    // request scope's DbContext, which throws on concurrent reads. The
    // gate below serialises every entry into LoadAsync — concurrent
    // callers either wait or coalesce.
    private readonly SemaphoreSlim _loadGate = new(1, 1);
    private async Task SafeReloadAsync()
    {
        if (_disposing) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_disposing) return;
        // If a load is already in flight, drop this call — the in-flight
        // one will pick up the latest data from EF anyway.
        if (!await _loadGate.WaitAsync(TimeSpan.FromSeconds(10)))
        {
            return;
        }
        try
        {
            if (_disposing) return;
            var typedId = new Loom.Domain.Nodes.NodeId(NodeId);
            _view = await Features.GetWorkspaceAsync(typedId);
            _artifacts = await ArtifactRepo.GetByNodeAsync(typedId);
            _nextPhase = NextPhase(_view?.Phase);
            _loaded = true;
            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
            // The page is being torn down; the request scope's DbContext
            // got disposed before this load finished. Nothing to render.
        }
        finally
        {
            _loadGate.Release();
        }
    }

    private async Task AdvanceAsync()
    {
        if (_view is null || _nextPhase is null) return;
        await Features.AdvancePhaseAsync(_view.NodeId, _nextPhase.Value);
        await LoadAsync();
    }

    private bool _workflowBusy;
    private string? _workflowError;
    private async Task RunWorkflowAsync(string workflowKey)
    {
        if (_view is null) return;
        _workflowBusy = true;
        _workflowError = null;
        var nodeId = _view.NodeId;
        try
        {
            // Resolve the workflow inside its own scope so the long-running
            // agent call doesn't share a DbContext with the page's render
            // pipeline.
            await using var scope = ScopeFactory.CreateAsyncScope();
            var workflows = scope.ServiceProvider.GetRequiredService<IWorkflowRepository>();
            var engine = scope.ServiceProvider.GetRequiredService<IWorkflowEngine>();

            var workflow = await workflows.GetCurrentByKeyAsync(Loom.Domain.Common.Slug.From(workflowKey));
            if (workflow is null)
            {
                _workflowError = $"Workflow '{workflowKey}' isn't seeded; restart the host so the bootstrapper can create it.";
                return;
            }

            var pausedAt = await engine.StartAsync(nodeId, workflow.Id, new Dictionary<string, string>());

            if (pausedAt is not null)
            {
                Nav.NavigateTo($"/runs/{pausedAt.Value.Value:D}/gate");
                return;
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _workflowError = ex.Message;
        }
        finally
        {
            _workflowBusy = false;
        }
    }

    private void StartRename()
    {
        if (_view is null) return;
        _titleDraft = _view.Title;
        _renameError = null;
        _renaming = true;
    }

    private void CancelRename()
    {
        _renaming = false;
        _renameError = null;
    }

    private async Task OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveRenameAsync();
        }
        else if (e.Key == "Escape")
        {
            CancelRename();
        }
    }

    private async Task SaveRenameAsync()
    {
        if (_view is null || _renamingBusy) return;
        var newTitle = (_titleDraft ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(newTitle))
        {
            _renameError = "Title can't be empty.";
            return;
        }
        if (newTitle == _view.Title)
        {
            _renaming = false;
            return;
        }
        _renamingBusy = true;
        _renameError = null;
        try
        {
            await Features.RenameAsync(_view.NodeId, newTitle, CurrentUser.GetUserId());
            _renaming = false;
            await LoadAsync();
        }
        catch (Loom.Domain.Common.DomainException ex)
        {
            _renameError = ex.Message;
        }
        finally
        {
            _renamingBusy = false;
        }
    }

